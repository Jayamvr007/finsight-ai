# ─── Copy this file to .env and fill in real values ───────────

# ── LLM ────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ── LangSmith Observability (optional but recommended) ─────────
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=finsight-ai-prod

# ── PostgreSQL ─────────────────────────────────────────────────
# Local:    postgresql://postgres:postgres@localhost:5432/finsight
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight

# ── Redis ──────────────────────────────────────────────────────
# Local:    redis://localhost:6379/0
# Upstash:  redis://default:[PASSWORD]@[HOST]:6379
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redis_secret

# ── Docker secrets ─────────────────────────────────────────────
POSTGRES_PASSWORD=postgres

# ── App ────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── ChromaDB (local, used until you migrate to PGVector) ───────
CHROMA_PERSIST_DIR=./chroma_db
